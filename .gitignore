# Generated session output: snapshots, action log, reversal script, HTML report.
# Scoped to the folder on purpose - a global `*.sh` or `*.txt` rule would also
# swallow real files such as tools/*.sh or requirements.txt.
backups/*
!backups/.gitkeep

# Platform tools binaries (downloaded, never committed)
tools/platform-tools/
/platform-tools/
*.zip

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Editor and OS artifacts
.env
*.env
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary logs
*.log
*.tmp
